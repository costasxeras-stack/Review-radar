# Copy these names into Render → your service → Environment. Never commit real values.
ANTHROPIC_API_KEY=
# Optional: protects the AI step so strangers can't spend your API credit
LAB_PASSWORD=
# Optional: max reviews sent to the AI per run (default 1500, max 5000)
MAX_REVIEWS=1500
# Optional: Claude model (default claude-haiku-5-5)
CLAUDE_MODEL=claude-haiku-5-5
